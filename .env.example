# Copy to .env (or set these in your service manager). Never commit .env.

# --- sign-in (pick one) ---
FOOD_PASSWORD=change-me-to-a-long-passphrase
# Behind a proxy that sets a verified identity header (e.g. Tailscale Serve), instead:
# FOOD_TRUST_HEADER=Tailscale-User-Login
# FOOD_ALLOWED_USER=you@example.com

# --- AI: any OpenAI-compatible endpoint with a vision model ---
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
# Optional fixed list for the model picker (otherwise read from /models):
# AI_MODELS=gpt-4o-mini,gpt-4o

# --- server ---
FOOD_HOST=127.0.0.1
FOOD_PORT=8800
FOOD_TZ=Asia/Kuala_Lumpur
FOOD_DATA_DIR=./data
# Public URL when served over HTTPS (enables strict Origin check + Secure cookie):
# FOOD_ORIGIN=https://food.example.com
